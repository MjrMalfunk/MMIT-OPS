generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkOrderSource {
  FIELD_NATION
  MANUAL
  SYNCRO
  OTHER
}

enum WorkOrderStatus {
  REQUESTED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  FORMER
}

enum ServiceTier {
  MANAGE
  PROTECT
  GOVERN
}

enum OpsUserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum OpsUserStatus {
  PENDING_MFA
  ACTIVE
  DISABLED
}

enum WorkOrderAttachmentKind {
  RECEIPT
  PHOTO
  TRACKER_EXPORT
  SIGNED_DOCUMENT
  OTHER
}

enum WorkOrderExpenseCategory {
  MATERIAL
  TRAVEL
  PARKING_TOLL
  EQUIPMENT_RENTAL
  OTHER
}

enum WorkOrderMaterialSource {
  PURCHASE
  INVENTORY_PULL
  OTHER
}

enum WorkOrderInvoiceStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum WorkOrderInvoiceLineType {
  LABOR
  MATERIAL
  EXPENSE
}

model Client {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name             String       @unique @db.VarChar(191)
  status           ClientStatus @default(PROSPECT)
  serviceTier      ServiceTier?
  syncroCustomerId String?      @unique @db.VarChar(64)
  email            String?      @db.VarChar(191)
  phone            String?      @db.VarChar(64)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @db.DateTime(3)
  workOrders       WorkOrder[]
}

model WorkOrder {
  id                  BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  source              WorkOrderSource
  sourceReference     String          @db.VarChar(191)
  status              WorkOrderStatus @default(REQUESTED)
  title               String          @db.VarChar(255)
  clientId            BigInt?         @db.UnsignedBigInt
  scheduledAt         DateTime?       @db.DateTime(3)
  checkInAt           DateTime?       @db.DateTime(3)
  checkOutAt          DateTime?       @db.DateTime(3)
  grossPay            Decimal?        @db.Decimal(10, 2)
  mileage             Decimal?        @db.Decimal(10, 2)
  driveMinutes        Int             @default(0) @db.UnsignedInt
  onsiteMinutes       Int             @default(0) @db.UnsignedInt
  adminMinutes        Int             @default(0) @db.UnsignedInt
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @db.DateTime(3)
  client              Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attachments         WorkOrderAttachment[]
  expenses            WorkOrderExpense[]
  materials           WorkOrderMaterial[]
  invoices            WorkOrderInvoice[]

  @@unique([source, sourceReference])
  @@index([status, scheduledAt])
  @@index([clientId])
}

model OpsUser {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  email                String        @unique @db.VarChar(191)
  displayName          String        @db.VarChar(191)
  role                 OpsUserRole   @default(OPERATOR)
  status               OpsUserStatus @default(PENDING_MFA)
  passwordHash         String        @db.VarChar(255)
  totpSecretCiphertext String        @db.Text
  mfaVerifiedAt        DateTime?     @db.DateTime(3)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  sessions             OpsSession[]
  recoveryCodes        OpsRecoveryCode[]
  invitationsCreated   OpsInvite[]   @relation("OpsInviteCreator")
  auditEvents          OpsAuditEvent[]
  attachmentsUploaded  WorkOrderAttachment[] @relation("WorkOrderAttachmentUploader")
  attachmentsDeleted   WorkOrderAttachment[] @relation("WorkOrderAttachmentDeleter")
  expensesCreated      WorkOrderExpense[]    @relation("WorkOrderExpenseCreator")
  expensesVoided       WorkOrderExpense[]    @relation("WorkOrderExpenseVoider")
  materialsCreated     WorkOrderMaterial[]   @relation("WorkOrderMaterialCreator")
  materialsVoided      WorkOrderMaterial[]   @relation("WorkOrderMaterialVoider")
  invoicesCreated      WorkOrderInvoice[]    @relation("WorkOrderInvoiceCreator")
  invoicesIssued       WorkOrderInvoice[]    @relation("WorkOrderInvoiceIssuer")
  invoicesVoided       WorkOrderInvoice[]    @relation("WorkOrderInvoiceVoider")
}

model OpsInvite {
  id          String    @id @default(uuid()) @db.Char(36)
  email       String    @db.VarChar(191)
  role        OpsUserRole @default(OPERATOR)
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.DateTime(3)
  acceptedAt  DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  invitedById BigInt    @db.UnsignedBigInt
  invitedBy   OpsUser   @relation("OpsInviteCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([email])
}

model OpsSession {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  userId    BigInt    @db.UnsignedBigInt
  user      OpsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OpsRecoveryCode {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  userId    BigInt    @db.UnsignedBigInt
  user      OpsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model OpsAuditEvent {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  subjectType String   @db.VarChar(64)
  subjectId   String   @db.VarChar(191)
  details     Json?
  createdAt   DateTime @default(now()) @db.DateTime(3)
  actorUserId BigInt   @db.UnsignedBigInt
  actor       OpsUser  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model WorkOrderAttachment {
  id           String                  @id @default(uuid()) @db.Char(36)
  kind         WorkOrderAttachmentKind @default(OTHER)
  originalName String                  @db.VarChar(191)
  mediaType    String                  @db.VarChar(127)
  byteSize     Int                     @db.UnsignedInt
  sha256       String                  @db.Char(64)
  storageKey   String                  @unique @db.VarChar(255)
  createdAt    DateTime                @default(now()) @db.DateTime(3)
  deletedAt    DateTime?               @db.DateTime(3)
  workOrderId  BigInt                  @db.UnsignedBigInt
  uploadedById BigInt                  @db.UnsignedBigInt
  deletedById  BigInt?                 @db.UnsignedBigInt
  workOrder    WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  uploadedBy   OpsUser                 @relation("WorkOrderAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy    OpsUser?                @relation("WorkOrderAttachmentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  @@unique([workOrderId, sha256])
  @@index([workOrderId, deletedAt, createdAt])
  @@index([uploadedById, createdAt])
}

model WorkOrderExpense {
  id            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  category      WorkOrderExpenseCategory @default(OTHER)
  description   String                   @db.VarChar(255)
  costAmount    Decimal                  @db.Decimal(10, 2)
  billAmount    Decimal?                 @db.Decimal(10, 2)
  occurredAt    DateTime?                @db.DateTime(3)
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @db.DateTime(3)
  updatedAt     DateTime                 @updatedAt @db.DateTime(3)
  voidedAt      DateTime?                @db.DateTime(3)
  workOrderId   BigInt                   @db.UnsignedBigInt
  createdById   BigInt                   @db.UnsignedBigInt
  voidedById    BigInt?                  @db.UnsignedBigInt
  workOrder     WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy     OpsUser                  @relation("WorkOrderExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      OpsUser?                 @relation("WorkOrderExpenseVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([workOrderId, voidedAt, occurredAt])
  @@index([createdById, createdAt])
}

model WorkOrderMaterial {
  id            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  source        WorkOrderMaterialSource  @default(PURCHASE)
  description   String                   @db.VarChar(255)
  sku           String?                  @db.VarChar(100)
  quantity      Decimal                  @db.Decimal(10, 3)
  unitCost      Decimal                  @db.Decimal(10, 2)
  unitPrice     Decimal?                 @db.Decimal(10, 2)
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @db.DateTime(3)
  updatedAt     DateTime                 @updatedAt @db.DateTime(3)
  voidedAt      DateTime?                @db.DateTime(3)
  workOrderId   BigInt                   @db.UnsignedBigInt
  createdById   BigInt                   @db.UnsignedBigInt
  voidedById    BigInt?                  @db.UnsignedBigInt
  workOrder     WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy     OpsUser                  @relation("WorkOrderMaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      OpsUser?                 @relation("WorkOrderMaterialVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([workOrderId, voidedAt, createdAt])
  @@index([createdById, createdAt])
}

model WorkOrderInvoice {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  status         WorkOrderInvoiceStatus @default(DRAFT)
  clientName     String                 @db.VarChar(191)
  clientEmail    String?                @db.VarChar(191)
  currency       String                 @default("USD") @db.Char(3)
  totalAmount    Decimal                @db.Decimal(10, 2)
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @db.DateTime(3)
  issuedAt       DateTime?              @db.DateTime(3)
  voidedAt       DateTime?              @db.DateTime(3)
  workOrderId    BigInt                 @db.UnsignedBigInt
  createdById    BigInt                 @db.UnsignedBigInt
  issuedById     BigInt?                @db.UnsignedBigInt
  voidedById     BigInt?                @db.UnsignedBigInt
  workOrder      WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy      OpsUser                @relation("WorkOrderInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy       OpsUser?               @relation("WorkOrderInvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy       OpsUser?               @relation("WorkOrderInvoiceVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  lines          WorkOrderInvoiceLine[]

  @@index([workOrderId, status, createdAt])
  @@index([status, issuedAt])
}

model WorkOrderInvoiceLine {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  lineType       WorkOrderInvoiceLineType
  description    String                   @db.VarChar(255)
  quantity       Decimal                  @db.Decimal(10, 3)
  unitAmount     Decimal                  @db.Decimal(10, 2)
  totalAmount    Decimal                  @db.Decimal(10, 2)
  sourceRecordId String?                  @db.VarChar(64)
  createdAt      DateTime                 @default(now()) @db.DateTime(3)
  invoiceId      BigInt                   @db.UnsignedBigInt
  invoice        WorkOrderInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, id])
}
