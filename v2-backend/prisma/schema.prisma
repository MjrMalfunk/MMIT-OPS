generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkOrderSource {
  FIELD_NATION
  MANUAL
  SYNCRO
  OTHER
}

enum WorkOrderStatus {
  REQUESTED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

enum WorkOrderPayType {
  FIXED
  HOURLY
  BLENDED
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  FORMER
}

enum ServiceTier {
  MANAGE
  PROTECT
  GOVERN
}

enum OpsUserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum OpsUserStatus {
  PENDING_MFA
  ACTIVE
  DISABLED
}

enum WorkOrderAttachmentKind {
  RECEIPT
  PHOTO
  TRACKER_EXPORT
  SIGNED_DOCUMENT
  OTHER
}

enum WorkOrderExpenseCategory {
  MATERIAL
  TRAVEL
  PARKING_TOLL
  EQUIPMENT_RENTAL
  OTHER
}

enum WorkOrderMaterialSource {
  PURCHASE
  INVENTORY_PULL
  OTHER
}

enum InventoryMovementKind {
  OPENING_BALANCE
  RECEIPT
  WORK_ORDER_USE
  ADJUSTMENT
}

enum WorkOrderInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum WorkOrderInvoiceLineType {
  LABOR
  MATERIAL
  EXPENSE
}

enum AccountingJournalStatus {
  POSTED
  VOIDED
}

enum AccountingJournalSourceType {
  WORK_ORDER_INVOICE
  PAYMENT
  ADJUSTMENT
}

enum InvoicePaymentStatus {
  PENDING
  POSTED
  VOIDED
}

enum InvoicePaymentMethod {
  ACH_BANK
  CARD
}

enum PaymentReconciliationStatus {
  APPLIED
  REVIEW_REQUIRED
  REJECTED
}

enum FieldNationImportStatus {
  RECEIVED
  PARSED
  REVIEW_REQUIRED
  CONVERTED
  REJECTED
}

model Client {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name             String       @unique @db.VarChar(191)
  status           ClientStatus @default(PROSPECT)
  serviceTier      ServiceTier?
  syncroCustomerId String?      @unique @db.VarChar(64)
  email            String?      @db.VarChar(191)
  phone            String?      @db.VarChar(64)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @db.DateTime(3)
  workOrders       WorkOrder[]
}

model WorkOrder {
  id                  BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  source              WorkOrderSource
  sourceReference     String          @db.VarChar(191)
  status              WorkOrderStatus @default(REQUESTED)
  title               String          @db.VarChar(255)
  clientId            BigInt?         @db.UnsignedBigInt
  scheduledAt         DateTime?       @db.DateTime(3)
  checkInAt           DateTime?       @db.DateTime(3)
  checkOutAt          DateTime?       @db.DateTime(3)
  grossPay            Decimal?        @db.Decimal(10, 2)
  payType             WorkOrderPayType @default(FIXED)
  payBaseAmount       Decimal?        @db.Decimal(10, 2)
  payBaseHours        Decimal?        @db.Decimal(8, 2)
  payHourlyRate       Decimal?        @db.Decimal(10, 2)
  payHoursCap         Decimal?        @db.Decimal(8, 2)
  actualGrossPay      Decimal?        @db.Decimal(10, 2)
  payCalculatedAt     DateTime?       @db.DateTime(3)
  payCalculation      Json?
  vehicleId           BigInt?         @db.UnsignedBigInt
  vehicleCostSnapshot Json?
  vehicle             Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  mileage             Decimal?        @db.Decimal(10, 2)
  estimatedMileage    Decimal?        @db.Decimal(10, 2)
  mileageSource       String          @default("UNVERIFIED") @db.VarChar(32)
  driveMinutes        Int             @default(0) @db.UnsignedInt
  onsiteMinutes       Int             @default(0) @db.UnsignedInt
  adminMinutes        Int             @default(0) @db.UnsignedInt
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @db.DateTime(3)
  client              Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attachments         WorkOrderAttachment[]
  expenses            WorkOrderExpense[]
  materials           WorkOrderMaterial[]
  invoices            WorkOrderInvoice[]
  fieldNationImport   FieldNationImport?
    trackerImport       WorkOrderTrackerImport?

  @@unique([source, sourceReference])
  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([vehicleId])
}

model FieldNationImport {
  id              BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  messageId       String                  @unique @db.VarChar(191)
  sender          String?                 @db.VarChar(191)
  subject         String?                 @db.VarChar(255)
  receivedAt      DateTime?               @db.DateTime(3)
  rawText         String                  @db.LongText
  status          FieldNationImportStatus @default(RECEIVED)
  sourceReference String?                 @db.VarChar(191)
  title           String?                 @db.VarChar(255)
  location        String?                 @db.VarChar(255)
  scheduledAt     DateTime?               @db.DateTime(3)
  grossPay        Decimal?                @db.Decimal(10, 2)
  payType         WorkOrderPayType        @default(FIXED)
  payBaseAmount   Decimal?                @db.Decimal(10, 2)
  payBaseHours    Decimal?                @db.Decimal(8, 2)
  payHourlyRate   Decimal?                @db.Decimal(10, 2)
  payHoursCap     Decimal?                @db.Decimal(8, 2)
  estimatedHours  Decimal?                @db.Decimal(8, 2)
  mileage         Decimal?                @db.Decimal(10, 2)
  score           Decimal?                @db.Decimal(5, 2)
  parsedData      Json?
  workOrderId     BigInt?                 @unique @db.UnsignedBigInt
  createdById     BigInt                  @db.UnsignedBigInt
  createdAt       DateTime                @default(now()) @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @db.DateTime(3)
  workOrder       WorkOrder?              @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdBy       OpsUser                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([sourceReference])
}

model WorkOrderTrackerImport {
  id              String      @id @default(uuid()) @db.Char(36)
  shiftId         String      @unique @db.Char(36)
  packetSchema    String      @db.VarChar(64)
  workOrderNumber String      @db.VarChar(191)
  contentSha256   String      @db.Char(64)
  rawPacket       Json
  metrics         Json
  warnings        Json
  startedAt       DateTime    @db.DateTime(3)
  completedAt     DateTime    @db.DateTime(3)
  appliedAt       DateTime    @default(now()) @db.DateTime(3)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  workOrderId     BigInt      @unique @db.UnsignedBigInt
  uploadedById    BigInt      @db.UnsignedBigInt
  workOrder       WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  uploadedBy      OpsUser     @relation("WorkOrderTrackerImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([workOrderNumber, createdAt])
  @@index([uploadedById, createdAt])
}

model OpsUser {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  email                String        @unique @db.VarChar(191)
  displayName          String        @db.VarChar(191)
  role                 OpsUserRole   @default(OPERATOR)
  status               OpsUserStatus @default(PENDING_MFA)
  passwordHash         String        @db.VarChar(255)
  totpSecretCiphertext String        @db.Text
  mfaVerifiedAt        DateTime?     @db.DateTime(3)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  sessions             OpsSession[]
  recoveryCodes        OpsRecoveryCode[]
  invitationsCreated   OpsInvite[]   @relation("OpsInviteCreator")
  auditEvents          OpsAuditEvent[]
  attachmentsUploaded  WorkOrderAttachment[] @relation("WorkOrderAttachmentUploader")
  attachmentsDeleted   WorkOrderAttachment[] @relation("WorkOrderAttachmentDeleter")
  expensesCreated      WorkOrderExpense[]    @relation("WorkOrderExpenseCreator")
  expensesVoided       WorkOrderExpense[]    @relation("WorkOrderExpenseVoider")
  materialsCreated     WorkOrderMaterial[]   @relation("WorkOrderMaterialCreator")
  materialsVoided      WorkOrderMaterial[]   @relation("WorkOrderMaterialVoider")
  invoicesCreated      WorkOrderInvoice[]    @relation("WorkOrderInvoiceCreator")
  invoicesIssued       WorkOrderInvoice[]    @relation("WorkOrderInvoiceIssuer")
  invoicesVoided       WorkOrderInvoice[]    @relation("WorkOrderInvoiceVoider")
  journalsPosted       AccountingJournal[]   @relation("AccountingJournalPoster")
  journalsVoided       AccountingJournal[]   @relation("AccountingJournalVoider")
  paymentsCreated      InvoicePayment[]      @relation("InvoicePaymentCreator")
  paymentsPosted       InvoicePayment[]      @relation("InvoicePaymentPoster")
  paymentReconciliations PaymentReconciliationEvent[] @relation("PaymentReconciliationRecorder")
  paymentReconciliationsReviewed PaymentReconciliationEvent[] @relation("PaymentReconciliationReviewer")
  fieldNationImports   FieldNationImport[]
    trackerImportsUploaded WorkOrderTrackerImport[] @relation("WorkOrderTrackerImportUploader")
}

model OpsInvite {
  id          String    @id @default(uuid()) @db.Char(36)
  email       String    @db.VarChar(191)
  role        OpsUserRole @default(OPERATOR)
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.DateTime(3)
  acceptedAt  DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  invitedById BigInt    @db.UnsignedBigInt
  invitedBy   OpsUser   @relation("OpsInviteCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([email])
}

model OpsSession {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  userId    BigInt    @db.UnsignedBigInt
  user      OpsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OpsRecoveryCode {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  userId    BigInt    @db.UnsignedBigInt
  user      OpsUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model OpsAuditEvent {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  subjectType String   @db.VarChar(64)
  subjectId   String   @db.VarChar(191)
  details     Json?
  createdAt   DateTime @default(now()) @db.DateTime(3)
  actorUserId BigInt   @db.UnsignedBigInt
  actor       OpsUser  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model WorkOrderAttachment {
  id           String                  @id @default(uuid()) @db.Char(36)
  kind         WorkOrderAttachmentKind @default(OTHER)
  originalName String                  @db.VarChar(191)
  mediaType    String                  @db.VarChar(127)
  byteSize     Int                     @db.UnsignedInt
  sha256       String                  @db.Char(64)
  storageKey   String                  @unique @db.VarChar(255)
  createdAt    DateTime                @default(now()) @db.DateTime(3)
  deletedAt    DateTime?               @db.DateTime(3)
  workOrderId  BigInt                  @db.UnsignedBigInt
  uploadedById BigInt                  @db.UnsignedBigInt
  deletedById  BigInt?                 @db.UnsignedBigInt
  workOrder    WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  uploadedBy   OpsUser                 @relation("WorkOrderAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy    OpsUser?                @relation("WorkOrderAttachmentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  @@unique([workOrderId, sha256])
  @@index([workOrderId, deletedAt, createdAt])
  @@index([uploadedById, createdAt])
}

model WorkOrderExpense {
  id            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  category      WorkOrderExpenseCategory @default(OTHER)
  description   String                   @db.VarChar(255)
  costAmount    Decimal                  @db.Decimal(10, 2)
  billAmount    Decimal?                 @db.Decimal(10, 2)
  occurredAt    DateTime?                @db.DateTime(3)
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @db.DateTime(3)
  updatedAt     DateTime                 @updatedAt @db.DateTime(3)
  voidedAt      DateTime?                @db.DateTime(3)
  workOrderId   BigInt                   @db.UnsignedBigInt
  createdById   BigInt                   @db.UnsignedBigInt
  voidedById    BigInt?                  @db.UnsignedBigInt
  workOrder     WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy     OpsUser                  @relation("WorkOrderExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      OpsUser?                 @relation("WorkOrderExpenseVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([workOrderId, voidedAt, occurredAt])
  @@index([createdById, createdAt])
}

model WorkOrderMaterial {
  id            BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  source        WorkOrderMaterialSource  @default(PURCHASE)
  description   String                   @db.VarChar(255)
  sku           String?                  @db.VarChar(100)
  quantity      Decimal                  @db.Decimal(10, 3)
  unitCost      Decimal                  @db.Decimal(10, 2)
  unitPrice     Decimal?                 @db.Decimal(10, 2)
  notes         String?                  @db.Text
  createdAt     DateTime                 @default(now()) @db.DateTime(3)
  updatedAt     DateTime                 @updatedAt @db.DateTime(3)
  voidedAt      DateTime?                @db.DateTime(3)
  workOrderId   BigInt                   @db.UnsignedBigInt
  inventoryItemId BigInt?                @db.UnsignedBigInt
  createdById   BigInt                   @db.UnsignedBigInt
  voidedById    BigInt?                  @db.UnsignedBigInt
  workOrder     WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryMovement InventoryMovement?
  createdBy     OpsUser                  @relation("WorkOrderMaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      OpsUser?                 @relation("WorkOrderMaterialVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([workOrderId, voidedAt, createdAt])
  @@index([inventoryItemId])
  @@index([createdById, createdAt])
}

model InventoryItem {
  id           BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  sku          String               @unique @db.VarChar(100)
  description  String               @db.VarChar(255)
  unit         String               @db.VarChar(32)
  quantityOnHand Decimal             @default(0) @db.Decimal(12, 3)
  reorderPoint Decimal               @default(0) @db.Decimal(12, 3)
  unitCost     Decimal               @default(0) @db.Decimal(10, 2)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @db.DateTime(3)
  updatedAt    DateTime             @updatedAt @db.DateTime(3)
  materials    WorkOrderMaterial[]
  movements    InventoryMovement[]

  @@index([active, sku])
}

model InventoryMovement {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  kind                InventoryMovementKind
  quantityDelta       Decimal               @db.Decimal(12, 3)
  unitCostSnapshot    Decimal               @db.Decimal(10, 2)
  notes               String?               @db.Text
  occurredAt          DateTime              @default(now()) @db.DateTime(3)
  createdAt           DateTime              @default(now()) @db.DateTime(3)
  inventoryItemId     BigInt                @db.UnsignedBigInt
  workOrderMaterialId BigInt?               @unique @db.UnsignedBigInt
  inventoryItem       InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  workOrderMaterial   WorkOrderMaterial?    @relation(fields: [workOrderMaterialId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, occurredAt])
}

model WorkOrderInvoice {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  status         WorkOrderInvoiceStatus @default(DRAFT)
  clientName     String                 @db.VarChar(191)
  clientEmail    String?                @db.VarChar(191)
  currency       String                 @default("USD") @db.Char(3)
  totalAmount    Decimal                @db.Decimal(10, 2)
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @db.DateTime(3)
  issuedAt       DateTime?              @db.DateTime(3)
  voidedAt       DateTime?              @db.DateTime(3)
  workOrderId    BigInt                 @db.UnsignedBigInt
  createdById    BigInt                 @db.UnsignedBigInt
  issuedById     BigInt?                @db.UnsignedBigInt
  voidedById     BigInt?                @db.UnsignedBigInt
  accountingJournalId BigInt?            @unique @db.UnsignedBigInt
  workOrder      WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  createdBy      OpsUser                @relation("WorkOrderInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy       OpsUser?               @relation("WorkOrderInvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy       OpsUser?               @relation("WorkOrderInvoiceVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  accountingJournal AccountingJournal?  @relation("WorkOrderInvoiceAccountingJournal", fields: [accountingJournalId], references: [id], onDelete: Restrict)
  lines          WorkOrderInvoiceLine[]
  payments       InvoicePayment[]

  @@index([workOrderId, status, createdAt])
  @@index([status, issuedAt])
}

model WorkOrderInvoiceLine {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  lineType       WorkOrderInvoiceLineType
  description    String                   @db.VarChar(255)
  quantity       Decimal                  @db.Decimal(10, 3)
  unitAmount     Decimal                  @db.Decimal(10, 2)
  totalAmount    Decimal                  @db.Decimal(10, 2)
  sourceRecordId String?                  @db.VarChar(64)
  createdAt      DateTime                 @default(now()) @db.DateTime(3)
  invoiceId      BigInt                   @db.UnsignedBigInt
  invoice        WorkOrderInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, id])
}

model AccountingJournal {
  id          BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  status      AccountingJournalStatus     @default(POSTED)
  sourceType  AccountingJournalSourceType
  sourceId    String                      @db.VarChar(64)
  memo        String                      @db.VarChar(255)
  postedAt    DateTime                    @default(now()) @db.DateTime(3)
  voidedAt    DateTime?                   @db.DateTime(3)
  createdAt   DateTime                    @default(now()) @db.DateTime(3)
  postedById  BigInt                      @db.UnsignedBigInt
  voidedById  BigInt?                     @db.UnsignedBigInt
  postedBy    OpsUser                     @relation("AccountingJournalPoster", fields: [postedById], references: [id], onDelete: Restrict)
  voidedBy    OpsUser?                    @relation("AccountingJournalVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  entries     AccountingJournalEntry[]
  invoice     WorkOrderInvoice?           @relation("WorkOrderInvoiceAccountingJournal")
  payment     InvoicePayment?

  @@unique([sourceType, sourceId])
  @@index([status, postedAt])
}

model InvoicePayment {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  status              InvoicePaymentStatus @default(PENDING)
  method              InvoicePaymentMethod
  processorReference  String?              @unique @db.VarChar(191)
  grossAmount         Decimal              @db.Decimal(10, 2)
  feeAmount           Decimal?             @db.Decimal(10, 2)
  netAmount           Decimal?             @db.Decimal(10, 2)
  receivedAt          DateTime?            @db.DateTime(3)
  postedAt            DateTime?            @db.DateTime(3)
  voidedAt            DateTime?            @db.DateTime(3)
  createdAt           DateTime             @default(now()) @db.DateTime(3)
  invoiceId           BigInt               @db.UnsignedBigInt
  accountingJournalId BigInt?              @unique @db.UnsignedBigInt
  createdById         BigInt               @db.UnsignedBigInt
  postedById          BigInt?              @db.UnsignedBigInt
  invoice             WorkOrderInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  accountingJournal   AccountingJournal?   @relation(fields: [accountingJournalId], references: [id], onDelete: Restrict)
  createdBy           OpsUser              @relation("InvoicePaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy            OpsUser?             @relation("InvoicePaymentPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reconciliationEvents PaymentReconciliationEvent[]

  @@index([invoiceId, status, createdAt])
}

model PaymentReconciliationEvent {
  id                   BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  status               PaymentReconciliationStatus
  processorEventId     String                     @unique @db.VarChar(191)
  balanceTransactionId String                     @unique @db.VarChar(191)
  payoutReference      String?                    @db.VarChar(191)
  processorReference   String                     @db.VarChar(191)
  actualMethod         InvoicePaymentMethod
  grossAmount          Decimal                    @db.Decimal(10, 2)
  feeAmount            Decimal                    @db.Decimal(10, 2)
  netAmount            Decimal                    @db.Decimal(10, 2)
  settledAt            DateTime                   @db.DateTime(3)
  reviewReason         String?                    @db.VarChar(255)
  reviewedAt           DateTime?                  @db.DateTime(3)
  reviewDecisionNote   String?                    @db.VarChar(255)
  createdAt            DateTime                   @default(now()) @db.DateTime(3)
  paymentId            BigInt                     @db.UnsignedBigInt
  recordedById         BigInt                     @db.UnsignedBigInt
  payment              InvoicePayment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  recordedBy           OpsUser                    @relation("PaymentReconciliationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reviewedBy           OpsUser?                   @relation("PaymentReconciliationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedById         BigInt?                    @db.UnsignedBigInt

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model AccountingJournalEntry {
  id          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  accountCode String              @db.VarChar(16)
  debitAmount Decimal             @db.Decimal(10, 2)
  creditAmount Decimal            @db.Decimal(10, 2)
  createdAt   DateTime            @default(now()) @db.DateTime(3)
  journalId   BigInt              @db.UnsignedBigInt
  journal     AccountingJournal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId, id])
  @@index([accountCode, createdAt])
}

model Vehicle {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  legacyId Int? @unique @db.UnsignedInt
  name String @db.VarChar(160)
  modelYear Int?
  make String? @db.VarChar(100)
  model String? @db.VarChar(140)
  trimName String? @db.VarChar(140)
  vin String? @db.VarChar(64)
  plate String? @db.VarChar(40)
  inServiceDate DateTime? @db.Date
  outOfServiceDate DateTime? @db.Date
  currentOdometer Decimal? @db.Decimal(12,2)
  acquisitionCost Decimal @default(0) @db.Decimal(12,2)
  expectedResidualValue Decimal @default(0) @db.Decimal(12,2)
  expectedServiceMiles Decimal @default(0) @db.Decimal(12,2)
  fuelMpgEstimate Decimal @default(0) @db.Decimal(8,2)
  fuelPricePerGallonEstimate Decimal @default(0) @db.Decimal(10,4)
  maintenanceReservePerMile Decimal @default(0) @db.Decimal(10,4)
  tireReservePerMile Decimal @default(0) @db.Decimal(10,4)
  repairReservePerMile Decimal @default(0) @db.Decimal(10,4)
  depreciationPerMileOverride Decimal? @db.Decimal(10,4)
  insuranceAnnualCost Decimal @default(0) @db.Decimal(12,2)
  registrationAnnualCost Decimal @default(0) @db.Decimal(12,2)
  otherFixedAnnualCost Decimal @default(0) @db.Decimal(12,2)
  expectedAnnualBusinessMiles Decimal @default(0) @db.Decimal(12,2)
  active Boolean @default(true)
  notes String? @db.Text
  legacyRecord Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  events VehicleEvent[]
  components VehicleComponent[]
  maintenance VehicleMaintenanceItem[]
  receipts VehicleReceipt[]
  documents VehicleDocument[]
  workOrders WorkOrder[]
  settings VehicleSettings?
}
model VehicleSettings {
  id Int @id
  defaultVehicleId BigInt? @unique @db.UnsignedBigInt
