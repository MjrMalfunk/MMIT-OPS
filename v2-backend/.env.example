NODE_ENV=development
PORT=3000
API_PORT=3000
MYSQL_ROOT_PASSWORD=change-this-before-running
MYSQL_DATABASE=mmit_v2
DATABASE_URL=mysql://root:change-this-before-running@db:3306/mmit_v2
REDIS_URL=redis://redis:6379
# Generate three different values before the first V2 auth deployment:
#   openssl rand -base64 32
AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret
AUTH_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
V2_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-bootstrap-token
